# ==============================================================
# Pardal PromoHub - Configurações de Arquitetura do Projeto (.env)
# ==============================================================
# NOTA IMPORTANTE:
# As credenciais de cada usuário (Telegram API ID/Hash, sessões do Telegram,
# chaves da Shopee, OpenRouter, Groq, Google Gemini e modelos de IA) são
# vinculadas de forma INDIVIDUAL e SEGURA por cada usuário diretamente
# na aba "Configurações" do Painel Web.
#
# O arquivo .env deve conter ESTRITAMENTE as configurações de arquitetura:
# ==============================================================

PROJECT_NAME="Pardal PromoHub"
VERSION="2.0.0"
API_V1_PREFIX="/api/v1"

# Chave secreta JWT (Gera automaticamente uma chave segura se omitida)
SECRET_KEY="insira_uma_chave_secreta_jwt_longa_e_segura_aqui"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Porta do servidor web (Dentro do container roda em 8000; no CasaOS mapeie 8085:8000)
PORT=8000
HOST="0.0.0.0"

# Banco de Dados Relacional Principal: PostgreSQL
# Nota: No CasaOS, a porta mapeada do PostgreSQL no host é 5438 (evitando conflito com 5432)
DATABASE_URL="postgresql://pardal_user:sua_senha_postgres_aqui@localhost:5438/pardal_promohub"
POSTGRES_PORT=5438
POSTGRES_DB="pardal_promohub"
POSTGRES_USER="pardal_user"
POSTGRES_PASSWORD="sua_senha_postgres_aqui"

# Webhooks Globais de Infraestrutura (Opcional - n8n / Microserviços de conversão)
N8N_MERCADOLIVRE_WEBHOOK="https://seu-n8n.com.br/webhook/conversor-afiliado-mercado-livre"
N8N_AMAZON_WEBHOOK="https://seu-n8n.com.br/webhook/afiliados-amazon"
N8N_MAGALU_WEBHOOK="https://seu-n8n.com.br/webhook/afiliados-magalu"
WPP_TEXT_WEBHOOK="https://seu-n8n.com.br/webhook/wpp-sender/text"
WPP_IMAGE_WEBHOOK="https://seu-n8n.com.br/webhook/wpp-sender/image"
ANALYTICS_API_BASE_URL="https://seu-n8n.com.br/webhook/csv_monitoramento_entradas_saidas_grupos"
