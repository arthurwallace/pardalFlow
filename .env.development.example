# ==============================================================
# Pardal PromoHub - Ambiente de Desenvolvimento (.env.development)
# ==============================================================
# Ao usar este arquivo, o sistema conecta DIRETAMENTE ao seu banco PostgreSQL na nuvem
# (Cloudflare Hyperdrive / Neon / Supabase), dispensando qualquer arquivo .db ou Docker local!
#
# Para usar:
# 1. Copie este arquivo para .env.development (ou renomeie para .env)
# 2. Crie uma base Postgres gratuita na nuvem (ex: Neon.tech - parceiro Cloudflare, ou Supabase)
# 3. Cole a DATABASE_URL fornecida abaixo (certifique-se de manter ?sslmode=require)
# ==============================================================

ENVIRONMENT="development"
PROJECT_NAME="Pardal PromoHub (DEV)"
VERSION="2.0.0"
API_V1_PREFIX="/api/v1"

# Conexão com PostgreSQL na nuvem (Substitua pelos dados do seu Neon/Cloudflare/Supabase):
DATABASE_URL="postgresql://usuario_dev:senha_dev@ep-cool-sample.us-east-2.aws.neon.tech/pardal_dev?sslmode=require"

# Segurança
SECRET_KEY="pardal_dev_secret_jwt_key_2026_super_secure"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Porta do Servidor FastAPI Local
PORT=8000
HOST="127.0.0.1"
